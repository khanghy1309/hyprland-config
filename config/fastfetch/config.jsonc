// fastfetch — thông tin máy hiện khi mở terminal lần đầu sau khi đăng nhập (gõ fastfetch để xem lại)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "color": { "1": "38;2;155;211;199" },
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 14 },
        "color": { "keys": "38;2;155;211;199", "title": "38;2;243;246;246" },
        "size": { "binaryPrefix": "jedec" }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name}  ·  {host-name}" },
        { "type": "os",       "key": "Hệ điều hành", "format": "{pretty-name}" },
        { "type": "kernel",   "key": "Nhân Linux" },
        { "type": "wm",       "key": "Giao diện", "format": "{pretty-name} {version}" },
        { "type": "packages", "key": "Gói đã cài" },
        { "type": "uptime",   "key": "Đã bật" },
        { "type": "cpu",      "key": "CPU" },
        { "type": "gpu",      "key": "Đồ hoạ" },
        { "type": "memory",   "key": "Bộ nhớ" },
        { "type": "disk",     "key": "Ổ đĩa", "folders": "/" },
        { "type": "battery",  "key": "Pin" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
